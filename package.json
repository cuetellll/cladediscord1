{
  "name": "pulsecord-platform",
  "version": "3.0.0",
  "description": "PulseCord — Discord-style realtime chat with LiveKit voice/video/screen share, Socket.IO, Prisma & PostgreSQL",
  "main": "dist/server/index.js",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "start:prod": "prisma migrate deploy && node dist/server/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "node test/api-e2e.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "^6.19.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.5.0",
    "livekit-server-sdk": "^2.6.0",
    "pg": "^8.23.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.7.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
